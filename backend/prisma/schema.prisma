generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Role: "ORGANIZADOR" | "STAFF_PORTA"
/// ReservationStatus: "PENDENTE" | "CONFIRMADO" | "CANCELADO" | "UTILIZADO"
/// PaymentMethod: "GPO" | "REF"
/// PaymentStatus: "pending" | "paid" | "expired" | "failed" | "cancelled" (valores da API Vero)

model BackofficeUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF_PORTA")
  createdAt    DateTime @default(now())
}

model TicketType {
  id           String        @id @default(uuid())
  name         String
  description  String
  refPrice     Int
  peopleCount  Int           @default(1)
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  reservations Reservation[]
}

model Reservation {
  id                String     @id @default(uuid())
  fullName          String
  contact           String
  contactNorm       String
  /// Para onde é enviado o bilhete com QR code.
  email             String?
  /// Marca o envio do bilhete por email, para não o enviar duas vezes.
  ticketEmailSentAt DateTime?
  ticketTypeId      String
  ticketType        TicketType @relation(fields: [ticketTypeId], references: [id])
  quantity          Int        @default(1)
  notes             String?
  status            String     @default("PENDENTE")
  /// Preenchido quando o sistema cancela o pedido: "PAGAMENTO_EXPIRADO" | "PAGAMENTO_FALHOU".
  /// Um pedido cancelado assim volta a ser confirmado se o pagamento chegar mais tarde.
  cancelReason      String?
  qrCode            String?    @unique
  createdAt         DateTime   @default(now())
  confirmedAt       DateTime?
  /// Última entrada registada (a lista completa está em CheckIn).
  checkedInAt       DateTime?
  payments          Payment[]
  checkIns          CheckIn[]

  @@index([contactNorm])
  @@index([status])
}

/// Cobrança criada na Vero Pays. O id é o da transação devolvido pela API,
/// guardado logo na criação para associar o webhook de confirmação.
model Payment {
  id              String      @id
  reservationId   String
  reservation     Reservation @relation(fields: [reservationId], references: [id])
  method          String
  amountKz        Int
  status          String      @default("pending")
  customerPhone   String?
  /// Página de pagamento da Vero, para o cliente voltar a ela (ex.: rever a referência).
  paymentUrl      String?
  referenceEntity String?
  referenceNumber String?
  expiresAt       DateTime?
  paidAt          DateTime?
  lastSyncedAt    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([reservationId])
  @@index([status])
}

/// Uma entrada no recinto. O bilhete vale uma entrada por dia de evento:
/// a restrição única impede duas entradas no mesmo dia, mesmo com leituras simultâneas.
model CheckIn {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  /// Dia do evento no fuso de Luanda, formato YYYY-MM-DD.
  eventDay      String
  checkedInAt   DateTime    @default(now())

  @@unique([reservationId, eventDay])
  @@index([eventDay])
}

/// Fotografia da galeria da página inicial, carregada no backoffice pelo organizador.
/// O ficheiro fica em UPLOAD_DIR com o nome `fileName`; a base de dados só guarda os metadados.
model GalleryPhoto {
  id        String   @id @default(uuid())
  fileName  String   @unique
  mimeType  String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

/// Pergunta frequente da página /faq, editada no backoffice pelo organizador.
model FaqItem {
  id        String   @id @default(uuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// Torneio de gaming (ex.: EA SPORTS FC 27, Mortal Kombat 11), gerido no backoffice.
/// TournamentEntryStatus: "PENDENTE" | "CONFIRMADO" | "CANCELADO"
model Tournament {
  id               String            @id @default(uuid())
  name             String
  game             String
  /// Opcional: as partidas são jogadas nos equipamentos disponibilizados pela organização.
  platform         String?
  description      String?
  /// Dia do torneio (YYYY-MM-DD, um dos dias do evento) e hora de início ("14:00").
  eventDay         String?
  startTime        String?
  entryFeeKz       Int
  maxPlayers       Int
  registrationOpen Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  entries          TournamentEntry[]

  @@index([sortOrder])
}

/// Inscrição de um jogador num torneio. Ocupa vaga enquanto está pendente (dentro do
/// prazo de pagamento) ou confirmada.
model TournamentEntry {
  id           String              @id @default(uuid())
  tournamentId String
  tournament   Tournament          @relation(fields: [tournamentId], references: [id])
  fullName     String
  gamerTag     String
  contact      String
  contactNorm  String
  email        String
  status       String              @default("PENDENTE")
  /// "PAGAMENTO_EXPIRADO" | "PAGAMENTO_FALHOU" quando é o sistema a cancelar.
  cancelReason String?
  /// Marca o envio do email de confirmação, para não o enviar duas vezes.
  emailSentAt  DateTime?
  createdAt    DateTime            @default(now())
  confirmedAt  DateTime?
  payments     TournamentPayment[]

  @@index([tournamentId, status])
  @@index([contactNorm])
}

/// Cobrança Vero de uma inscrição em torneio. Separada de Payment para não misturar
/// o fluxo dos bilhetes; o webhook é o mesmo e encaminha pelo id da transação.
model TournamentPayment {
  id              String          @id
  entryId         String
  entry           TournamentEntry @relation(fields: [entryId], references: [id])
  method          String
  amountKz        Int
  status          String          @default("pending")
  customerPhone   String?
  paymentUrl      String?
  referenceEntity String?
  referenceNumber String?
  expiresAt       DateTime?
  paidAt          DateTime?
  lastSyncedAt    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([entryId])
  @@index([status])
}

/// Atividade da página /programacao, gerida no backoffice pelo organizador.
model ProgramItem {
  id          String   @id @default(uuid())
  /// Dia do evento (YYYY-MM-DD) e horas no formato "14:00"; a hora de fim é opcional.
  eventDay    String
  startTime   String
  endTime     String?
  title       String
  /// Zona do recinto (ex.: "Palco Principal").
  zone        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventDay, startTime])
}

/// Visualização de página do site público, enviada pelo frontend. Serve para contar
/// visitantes únicos e sessões (métricas kwamikon_* no Grafana). É anónima: o visitorId
/// é um UUID aleatório guardado no browser e o IP não é registado.
/// Device: "mobile" | "tablet" | "desktop"
model PageView {
  id        String   @id @default(uuid())
  visitorId String
  sessionId String
  path      String
  /// Origem da sessão (ex.: "google", "instagram", "direto"); só na primeira página da sessão.
  source    String?
  device    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
}
