DATABASE_URL="file:./dev.db"
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="12h"
PORT=3333
CORS_ORIGIN="http://localhost:5173"

# Pasta das fotografias da galeria (em produção: /app/data/uploads, no volume da base de dados)
UPLOAD_DIR="./uploads"

# Vero Pays (https://pays.vero.ao) — chave e segredo do projecto no dashboard
VERO_API_URL="https://pays.vero.ao"
VERO_API_KEY="valor_de_exemplo"
VERO_WEBHOOK_SECRET="valor_de_exemplo"

# Dias em que os bilhetes dão entrada (uma por dia), hora de Luanda
EVENT_DAYS="2026-10-31,2026-11-01"

# URL público do site: a página de pagamento da Vero devolve o cliente a /bilhetes
PUBLIC_SITE_URL="http://localhost:5173"
# URL público desta API: a Vero devolve o cliente a /api/payments/return/:reserva
PUBLIC_API_URL="http://localhost:3333"

# Envio do bilhete por email (sem SMTP_HOST os emails não são enviados)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Kwamikon Nexus <bilhetes@kwamikon.ao>"

# Passwords dos utilizadores de backoffice criados pelo seed. Só são aplicadas quando
# os utilizadores são criados (primeiro arranque): definir antes do primeiro deploy.
SEED_ORG_PASSWORD="..."
SEED_STAFF_PASSWORD="..."
