    {
      "type": "stat",
      "title": "LCP",
      "description": "Largest Contentful Paint: tempo até o conteúdo principal aparecer. Bom < 2,5 s; mau > 4 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.75, sum by (le) (rate(kwamikon_web_vital_duration_seconds_bucket{metric=\"LCP\"}[$__range])))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2.5
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          },
