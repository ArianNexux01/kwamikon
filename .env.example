# Variáveis do docker-compose.prod.yml (copiar para .env na raiz do projecto).
# Domínio público, sem https:// nem barra final.
DOMAIN=kwamikon.com

# Imagens publicadas no Docker Hub (utilizador/repositório:tag).
BACKEND_IMAGE=utilizador/kwamikon-backend:latest
FRONTEND_IMAGE=utilizador/kwamikon-frontend:latest

# Observabilidade (docker-compose.observability.yml).
# Grafana em https://<dominio>/grafana/; trocar a password antes do primeiro arranque.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-password
GRAFANA_ROOT_URL=https://kwamikon.com/grafana/
# Durante quanto tempo o Prometheus guarda as métricas.
PROMETHEUS_RETENTION=30d
