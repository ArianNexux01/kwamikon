# Variáveis do docker-compose.prod.yml (copiar para .env na raiz do projecto).
# Domínio público, sem https:// nem barra final.
DOMAIN=kwamikon.com

# Imagens publicadas no Docker Hub (utilizador/repositório:tag).
BACKEND_IMAGE=utilizador/kwamikon-backend:latest
FRONTEND_IMAGE=utilizador/kwamikon-frontend:latest
